{
  "name": "cv-writer",
  "version": "0.5.0",
  "private": true,
  "description": "End-to-end CV writer: a coordinator agent with writer and critic subagents on Ollama cloud models, with Playwright PDF rendering.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server/main.ts",
    "dev": "tsx watch src/server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:live": "LIVE=1 vitest run tests/live"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "esbuild": "^0.28.2",
    "hono": "^4.13.13",
    "ollama": "^0.6.4",
    "playwright": "^1.64.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
