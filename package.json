{
  "name": "cv-writer",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "End-to-end CV writing app: one coordinator agent + writer/critic subagents on Ollama cloud models",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:client && tsx watch src/server/index.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "marked": "18.1.2",
    "pg": "^8.23.1",
    "playwright": "1.65.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
