# --- Server ---
PORT=3000
HOST=0.0.0.0
# Set to "production" when deployed behind HTTPS (enables Secure cookies).
NODE_ENV=development

# --- Database ---
# Production: a real PostgreSQL connection string.
# DATABASE_URL=postgres://user:password@host:5432/cv_writer
# Local dev without Postgres installed: leave DATABASE_URL empty and an embedded
# PGlite (WASM Postgres) database is stored here instead.
PGLITE_DIR=./data/pglite

# --- Ollama ---
# Option A (deployments): Ollama cloud directly. Create a key at https://ollama.com/settings/keys
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=your_key
# Option B (local): a local Ollama daemon signed in with `ollama signin`, using ":cloud" models.
# OLLAMA_HOST=http://localhost:11434

# Models per agent (":cloud"/"-cloud" suffixes are stripped automatically when talking to ollama.com)
COORDINATOR_MODEL=kimi-k2.6:cloud
WRITER_MODEL=kimi-k2.6:cloud
CRITIC_MODEL=kimi-k2.6:cloud
# Optional overrides; otherwise detected via /api/show, falling back to DEFAULT_CONTEXT_WINDOW.
# COORDINATOR_CONTEXT_WINDOW=262144
DEFAULT_CONTEXT_WINDOW=131072

# --- Auth ---
SESSION_TTL_DAYS=30
ALLOW_REGISTRATION=true
