# --- Ollama (cloud models) ---
# Railway / production: create a key at https://ollama.com/settings/keys. With a key set,
# OLLAMA_HOST defaults to https://ollama.com and web search uses Ollama's web_search API.
OLLAMA_API_KEY=
# Local dev without a key: a local `ollama` daemon signed in to ollama.com (`ollama signin`).
# OLLAMA_HOST=http://127.0.0.1:11434

# Default model for all agents, overridable per agent.
OLLAMA_MODEL=kimi-k2.6:cloud
# COORDINATOR_MODEL=
# WRITER_MODEL=
# CRITIC_MODEL=
# Used only if the model's context length can't be read from /api/show.
# CONTEXT_WINDOW=131072
# COORDINATOR_MAX_STEPS=24
# WRITER_MAX_STEPS=30
# CRITIC_MAX_STEPS=12

# --- Database ---
# PostgreSQL connection string (Railway injects this from the Postgres service).
# Leave empty for local dev: an embedded PGlite database is stored in PGLITE_DIR.
DATABASE_URL=
# PGLITE_DIR=./data/db

# --- Server ---
PORT=3000
# NODE_ENV=production   # enables Secure cookies
# COOKIE_SECURE=true
