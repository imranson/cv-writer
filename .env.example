# Local Ollama daemon (signed in with `ollama signin`) serving cloud models, e.g. kimi-k2.6:cloud
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=kimi-k2.6:cloud
# Required for web search (and preferred for web fetch). Create at https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Optional per-agent model overrides
# COORDINATOR_MODEL=
# WRITER_MODEL=
# CRITIC_MODEL=
# Optional reasoning setting: true, false, low, medium, high (unset = model default).
# false is roughly 2-3x faster per call with kimi-k2.6.
# OLLAMA_THINK=
# Optional context window override (tokens); otherwise read from the model
# CONTEXT_WINDOW=
PORT=3000
DATA_DIR=./data
SKILLS_DIR=./skills
