# Ollama endpoint: https://ollama.com (direct cloud API, needs OLLAMA_API_KEY)
# or http://localhost:11434 (local daemon signed in with `ollama signin`)
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=kimi-k2.6:cloud
# Required for web search (and the direct cloud API). Create at https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Optional per-agent model overrides
# COORDINATOR_MODEL=
# WRITER_MODEL=
# CRITIC_MODEL=
# Optional reasoning setting: true, false, low, medium, high (unset = model default)
# OLLAMA_THINK=false
# Optional context window override (tokens); otherwise read from the model
# CONTEXT_WINDOW=
# Optional secret for signing auth cookies (otherwise generated into DATA_DIR)
# SESSION_SECRET=
PORT=4817
DATA_DIR=./data
SKILLS_DIR=./skills
